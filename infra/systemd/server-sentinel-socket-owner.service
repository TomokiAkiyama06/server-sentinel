# ServerSentinel listener socket-owner helper (Issue #126, Owner decision
# 2026-10-01). It reports only who holds a listening socket (executable path
# and system unit, or whether the requester alone holds it) to the non-root
# ServerSentinel service, which never gains privilege itself.
#
# Privilege: a transient non-root account (DynamicUser) with exactly two
# capabilities, the minimum the kernel requires to read another account's
# /proc/<pid> socket ownership:
#   CAP_DAC_READ_SEARCH  list /proc/<pid>/fd of processes of other accounts
#                        (and read the root-owned, group-only deployment
#                        configuration);
#   CAP_SYS_PTRACE       pass ptrace_may_access(PTRACE_MODE_READ) for the
#                        /proc/<pid>/fd/* and /proc/<pid>/exe links.
# Every system call that turns CAP_SYS_PTRACE into access to another process
# is denied by name, not only through a group: ptrace and pidfd_getfd
# (@debug), process_vm_readv / process_vm_writev / process_madvise (these sit
# in @ipc, which @system-service includes, NOT in @debug), and kcmp (in
# @system-service itself). open_by_handle_at, the CAP_DAC_READ_SEARCH escape,
# is denied by name as well as through @privileged. This removes those system
# call interfaces only; it does not stop a compromised helper (see below).
# It has no network (PrivateNetwork, AF_UNIX only).
#
# Mount masking (defence in depth only, NOT containment): the trees that can
# hold data (/etc, /var, /srv, /mnt, /media, /opt, /run) are replaced by empty
# read-only tmpfs and /home, /root, /boot and /efi are inaccessible; only the
# installation root (code and per-release venv), the one deployment
# configuration file and the dynamic linker cache are bound back read-only, and
# /usr and /lib stay visible for the interpreter. This only reduces what an
# uncompromised helper could reach by an ordinary path (its own code names no
# such path and never opens /proc/<pid>/root, cwd, mem or fd entries). It does
# NOT isolate a compromised helper: with CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH,
# code running inside the helper can still read every host file through
# /proc/<pid>/root (and cwd), open any process's files through
# /proc/<pid>/fd/<n>, and read or write another process's memory through
# /proc/<pid>/mem, none of which the unit can close without hiding processes
# from the scan. Containment of a compromised helper (Landlock) is planned in
# Issue #147 (Owner decision, 2026-10-07). A top-level tree outside the masked
# list (a custom data mount such as /data) is also reachable by path until the
# Owner adds it to InaccessiblePaths= in a drop-in.
# Do not add PrivateUsers= (capabilities would no longer apply to host
# processes) or ProtectProc=invisible / PrivatePIDs= (other processes would be
# hidden, so every scan would be incomplete and access would stay closed).
#
# The paths below are the documented defaults (server/docs/DEPLOYMENT.md);
# when the installation root or configuration path differs, override
# ExecStart=, WorkingDirectory= and the matching BindReadOnlyPaths= entry with
# `systemctl edit`, never by editing this file in place.

[Unit]
Description=ServerSentinel listener socket-owner helper
Requires=server-sentinel-socket-owner.socket
After=server-sentinel-socket-owner.socket
Before=server-sentinel.service
# A release update or rollback restarts server-sentinel.service; the helper
# restarts with it, so it always runs the current release's code.
PartOf=server-sentinel.service

[Service]
Type=simple
ExecStart=/opt/server-sentinel-main/current/venv/bin/python -E -s -B -m app.auth.socket_owner --config /etc/server-sentinel/deployment.json
WorkingDirectory=/opt/server-sentinel-main/current
Restart=on-failure
RestartSec=2
DynamicUser=yes
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/etc:ro /var:ro /srv:ro /mnt:ro /media:ro /opt:ro /run:ro
InaccessiblePaths=-/boot -/efi
BindReadOnlyPaths=/opt/server-sentinel-main
BindReadOnlyPaths=/etc/server-sentinel/deployment.json
BindReadOnlyPaths=-/etc/ld.so.cache
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @privileged @resources @mount
SystemCallFilter=~ptrace pidfd_getfd process_vm_readv process_vm_writev process_madvise kcmp open_by_handle_at
SystemCallErrorNumber=EPERM
TasksMax=4
MemoryMax=128M
LimitNOFILE=256
