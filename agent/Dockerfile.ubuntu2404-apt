# Issue #428: the capture host runs Ubuntu 24.04 with the apt python3 and
# python3-cryptography (41.x) instead of the hash-pinned wheel lock. This image
# holds only those distribution packages; CI bind-mounts the checkout read-only
# and runs the Agent tests from agent/ so the repository layout (code_root,
# docs/, pyproject.toml) is the same as in a checkout. Nothing is copied in.
FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-cryptography \
    && rm -rf /var/lib/apt/lists/*
USER 65534:65534
