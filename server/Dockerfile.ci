# CI-only, unmodified Debian/Python base aggregation; see docs/DEPENDENCIES.md.
FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.lock requirements-ci.lock requirements-detector.lock ./
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-ci.lock
COPY app ./app
COPY tests ./tests
COPY docs ./docs
USER 65534:65534
CMD ["python", "-m", "tests.smoke", "normal"]
