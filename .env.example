# ServerSentinel example configuration.
# Never commit real secrets or private deployment values.

SERVERSENTINEL_RECORDING_ROOT=/srv/server-sentinel
SERVERSENTINEL_RETENTION_DAYS=20
SERVERSENTINEL_AUDIT_RETENTION_DAYS=90
SERVERSENTINEL_MAX_STORAGE_GB=
SERVERSENTINEL_MAX_ACTIVE_VIDEO_SOURCES=4
SERVERSENTINEL_TIMEZONE=Etc/UTC

# Optional Slack integration. Leave empty when disabled.
SLACK_WEBHOOK_URL=

# Camera sources, owner credentials, biometric enrollment, and pairing credentials
# are managed through the application/database rather than committed here.
# Exact config names may change during implementation.
