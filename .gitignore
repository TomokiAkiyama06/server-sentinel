# Environment / secrets (including synthetic fixture paths)
# Sensitive/media extension rules below match lowercase, uppercase, and mixed case.
.env
.env.*
!.env.example
.envrc
.secrets/
secrets/
credentials/
keys/
private-keys/
private_keys/
certs/
certificates/
.credentials
credentials*.[jJ][sS][oO][nN]
credentials*.[yY][aA][mM][lL]
credentials*.[yY][mM][lL]
credentials*.[tT][oO][mM][lL]
.netrc
.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]8
*.[pP]12
*.[pP][fF][xX]
*.[mM][oO][bB][iI][lL][eE][pP][rR][oO][vV][iI][sS][iI][oO][nN]
*.[cC][eE][rR]
*.[dD][eE][rR]
*.[cC][rR][tT]
*.[cC][sS][rR]
*.[pP][rR][oO][vV][iI][sS][iI][oO][nN][pP][rR][oO][fF][iI][lL][eE]

# Deployment media/data belongs outside the checkout. Root-scoped paths preserve
# source modules such as web/src/recordings/ and server/app/media/.
/recordings/
/data/
/diagnostics/
/media/
/captures/
/snapshots/
/uploads/

# Agent runtime / deployment-local security data
buffer/
incidents/
runtime/
local-state/
real-media/
real-footage/
camera-footage/

