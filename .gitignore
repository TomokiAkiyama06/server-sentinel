*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[vV]
*.[mM][kK][vV]
*.[aA][vV][iI]
*.[wW][eE][bB][mM]
*.[mM]2[tT][sS]
*.[hH]264
*.[hH]265
*.[hH][eE][vV][cC]
*.[mM][jJ][pP][eE][gG]
*.[mM][jJ][pP][gG]
*.[yY][uU][vV]
