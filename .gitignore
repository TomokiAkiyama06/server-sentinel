*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[dD][nN][gG]

# Images in ordinary fixture paths are excluded; UI assets elsewhere remain
# trackable. Ignore patterns cannot classify real-person/real-room content.
# Review/CI must enforce synthetic provenance; never place real media or raw
# deployment identifiers in source/fixture paths, even under an allowed name.
tests/fixtures/**/*.[jJ][pP][gG]
tests/fixtures/**/*.[jJ][pP][eE][gG]
tests/fixtures/**/*.[pP][nN][gG]
tests/fixtures/**/*.[wW][eE][bB][pP]
tests/fixtures/**/*.[gG][iI][fF]
tests/fixtures/**/*.[bB][mM][pP]
tests/fixtures/**/*.[tT][iI][fF]
tests/fixtures/**/*.[tT][iI][fF][fF]

# Only generated media and inventory exports may be committed in this subtree.
# These targeted exceptions never allow .env, credentials, keys, or certificates.
!tests/fixtures/synthetic/**/*.[jJ][pP][gG]
!tests/fixtures/synthetic/**/*.[jJ][pP][eE][gG]
